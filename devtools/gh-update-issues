#!/usr/bin/env bash
#
# gh-update-issues
#
# Applies the regenerated issue markdown files to existing GitHub issues,
# one at a time, via `gh issue edit`. Overwrites title + body in place —
# does NOT delete/recreate, so issue numbers, URLs, and comment history
# are preserved.
#
# Usage:
#   ./gh-update-issues /path/to/issues-folder
#   ./gh-update-issues /path/to/single-issue-file.md
#
# If the path is a directory, every issue-*.md file inside it is applied.
# If the path is a single file, only that file is applied. Either way the
# filename must still be issue-NN-....md — that's how the script knows
# which issue number to target.
#
# Options:
#   --auto        Apply all updates without pausing for confirmation
#                  (default: pauses before each issue, y/n/s/q)
#   --dry-run     Show what would be sent, apply nothing
#   --repo OWNER/REPO   Explicit repo (default: detected via
#                  'gh repo view' from the current directory's git remote)
#
# Requires: gh CLI installed and authenticated (`gh auth status`),
# and to be run from inside the target repo (or pass --repo).

set -euo pipefail

ISSUES_PATH="${1:-}"
AUTO=false
DRY_RUN=false
REPO=""

shift || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --auto) AUTO=true ;;
        --dry-run) DRY_RUN=true ;;
        --repo)
            shift
            REPO="$1"
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
    shift
done

if [[ -z "$ISSUES_PATH" || ! -e "$ISSUES_PATH" ]]; then
    echo "Usage: $0 /path/to/issues-folder-or-file [--auto] [--dry-run] [--repo OWNER/REPO]" >&2
    exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
    echo "Error: gh CLI not found. Install from https://cli.github.com/" >&2
    exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
    echo "Error: gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
fi

if [[ -z "$REPO" ]]; then
    REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
    if [[ -z "$REPO" ]]; then
        echo "Error: --repo not specified and could not be detected from the current directory (run inside a git repo with a GitHub remote, or pass --repo OWNER/REPOSITORY)." >&2
        exit 1
    fi
    echo "Using repository: $REPO"
fi
REPO_FLAG=(--repo "$REPO")

if [[ -f "$ISSUES_PATH" ]]; then
    FILES=("$ISSUES_PATH")
else
    shopt -s nullglob
    FILES=("$ISSUES_PATH"/issue-*.md)
    shopt -u nullglob

    if [[ ${#FILES[@]} -eq 0 ]]; then
        echo "No issue-*.md files found in $ISSUES_PATH" >&2
        exit 1
    fi
fi

# Sort numerically by the issue number embedded in the filename
IFS=$'\n' SORTED=($(printf '%s\n' "${FILES[@]}" | sort -t- -k2 -n))
unset IFS

echo "Found ${#SORTED[@]} issue file(s) in $ISSUES_PATH"
echo

APPLIED=0
SKIPPED=0

for FILE in "${SORTED[@]}"; do
    BASENAME=$(basename "$FILE")

    # Extract issue number from filename: issue-06-C2-....md -> 6
    NUM=$(echo "$BASENAME" | sed -E 's/^issue-0*([0-9]+)-.*/\1/')

    if [[ -z "$NUM" || ! "$NUM" =~ ^[0-9]+$ ]]; then
        echo "Skipping $BASENAME  could not parse issue number from filename."
        ((SKIPPED++)) || true
        continue
    fi

    # Title = first line, stripped of leading "# "
    TITLE=$(head -n 1 "$FILE" | sed -E 's/^#\s*//')

    # Body = everything after the first line, with leading blank line trimmed
    BODY_FILE=$(mktemp)
    tail -n +2 "$FILE" | sed '/./,$!d' > "$BODY_FILE"

    echo "-----------------------------------------------------------"
    echo "Issue #$NUM"
    echo "Title: $TITLE"
    echo "File:  $BASENAME"
    echo "-----------------------------------------------------------"

    if $DRY_RUN; then
        echo "[dry-run] Would run: gh issue edit $NUM --title \"$TITLE\" --body-file $BASENAME"
        rm -f "$BODY_FILE"
        continue
    fi

    if ! $AUTO; then
        read -rp "Apply this update? [y/N/s(kip)/q(uit)] " ANSWER
        case "$ANSWER" in
            y|Y) ;;
            s|S)
                echo "Skipped #$NUM."
                ((SKIPPED++)) || true
                rm -f "$BODY_FILE"
                continue
                ;;
            q|Q)
                echo "Quitting. Applied: $APPLIED, Skipped: $SKIPPED"
                rm -f "$BODY_FILE"
                exit 0
                ;;
            *)
                echo "Skipped #$NUM."
                ((SKIPPED++)) || true
                rm -f "$BODY_FILE"
                continue
                ;;
        esac
    fi

    if gh issue edit "$NUM" "${REPO_FLAG[@]}" --title "$TITLE" --body-file "$BODY_FILE"; then
        echo "Updated #$NUM."
        ((APPLIED++)) || true
    else
        echo "FAILED to update #$NUM  check the issue number exists and gh has write access." >&2
    fi

    rm -f "$BODY_FILE"
    echo
done

echo "-----------------------------------------------------------"
echo "Done. Applied: $APPLIED, Skipped: $SKIPPED"
